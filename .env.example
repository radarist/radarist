# Public Radarist runtime environment contract. Copy to .env.local and configure only enabled services.
# Defaults and inline guidance are retained from the reviewed source template; never commit credentials.
# Runtime-owned values and undocumented legacy aliases are deliberately omitted.

AI_DAILY_BUDGET_USD=10
AI_PARALLEL_TOOL_CALLS=3
AI_RATE_LIMIT_RPM=30
ANTHROPIC_API_KEY=your-anthropic-api-key
# APP_VERSION=0.1.0 # Optional public release identity override.
ASSERTER_RELIABILITY_ENABLED=false  # OPTIONAL — per-asserter decayed approve/reject bonus (±10) shifts the 75-point materialization gate; build-autopilot relations require raw confidence 85 while enabled so the maximum -10 penalty cannot create an approved-but-withheld edge. Outcomes still accrue whenever DISCOVERY_FEEDBACK_ENABLED is on — this flag only gates whether the accrued history is CONSUMED.
BRAVE_API_KEY=your-brave-search-api-key
# BUILD_AGENT_RUNTIME=1
# BUILD_ASSESSMENT_AUTO_APPROVE_THRESHOLD=75    # min verdict confidence (0-100) for autopilot auto-apply
# BUILD_AUTOPILOT_ENABLED=false
# BUILD_DEFAULT_RADAR_ID=                       # radar an autopilot evaluation places onto (else reviewer picks at approval)
# CHAT_LOOP_BUDGET_MS=300000             # real wall-clock budget for the whole chat turn (the true bound; maxDuration=300 is the serverless ceiling)
# CHAT_MODEL_CALL_TIMEOUT_MS=120000      # per model API call timeout (ms)
# CHAT_STREAMING_ENABLED=false           # server-side opt-in to SSE streaming (also requires the in-code STREAMING_DISABLED flag to be false)
# CHAT_TOOL_CALL_TIMEOUT_MS=35000        # per tool-call timeout (ms)
# CHAT_TOOL_RESULT_CAP=50000             # max chars of a single tool result fed back to the model
# CHAT_TOOL_RESULT_TURN_BUDGET=120000 # Optional maximum model-facing tool payload characters per turn; non-positive disables.
CLAUDE_CHAT_ENABLED=false # Route chat through the Claude orchestrator when enabled.
CLAUDE_CHAT_MODEL=claude-sonnet-4-6
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=128000
CONFIDENCE_SCALE_100_ENABLED=true      # Mint relation confidence on the 0-100 scale (relation-defaults, chunk-mentions, sync ingress); false restores legacy 0-1 minting
# DEFENSE_MINISTER_ENABLED=false
DISCOVERY_ADJACENT_KEYWORDS=false # OPTIONAL — inject a bounded budget of ranked adjacent-but-untracked topic keywords into signal fetching (broadens the scout's reach beyond exact interests). Default off; REQUIRES DISCOVERY_FEEDBACK_ENABLED=true
# DISCOVERY_DEDUP_SIMILARITY_THRESHOLD=0.85  # OPTIONAL — cosine threshold above which candidates are duplicates
DISCOVERY_DERIVE_INTEREST=false   # derive InterestProfile from exploration (scout route + nightly cron)
# DISCOVERY_EXPLORATION_RATE=0.15            # OPTIONAL — exploration weight that keeps under-explored topics visible
DISCOVERY_FEEDBACK_ENABLED=true  # demo default — the learning loops (US-2/3/4) are the showcase
# DISCOVERY_MAX_DISPATCH_PER_CYCLE=2         # OPTIONAL — count-cap budget substitute: max evaluations dispatched per sweep
# DISCOVERY_MAX_ENTITY_TYPE_SHARE=0.4        # OPTIONAL — per-dimension cap (max share of a cycle from one entity type)
DISCOVERY_MAX_NETNEW_PER_CYCLE=3    # max net-new technologies proposed per sweep cycle
# DISCOVERY_MAX_SOURCE_SHARE=0.4             # OPTIONAL — source-rotation cap (max share of a cycle from one source)
# DISCOVERY_MAX_USECASE_DISPATCH_PER_CYCLE=1 # OPTIONAL — max useCase (secondary dimension) evaluations dispatched per sweep cycle
# DISCOVERY_MMR_LAMBDA=0.7                    # OPTIONAL — MMR relevance/diversity tradeoff (1=relevance, 0=diversity)
DISCOVERY_NETNEW_DIMENSIONS=technology,useCase,painPoint,company   # which dimensions the scout discovers net-new
DISCOVERY_NETNEW_ENABLED=false      # net-new technology discovery (research -> pending proposedEntities)
# DISCOVERY_PENDING_PROPOSALS_CAP=30         # OPTIONAL — skip a sweep when pending proposals already exceed this
# DISCOVERY_RADAR_ID=                         # OPTIONAL — radar discovery scopes candidates to (joins radarPlacements → technologyId); empty → build default / sole radar
# DISCOVERY_SCOUT_DEBOUNCE_MS=14400000       # OPTIONAL — per-user "Scout my radar" debounce window (default 4h)
# DISCOVERY_SWEEP_CRON='TZ=UTC 30 1,13 * * *'   # OPTIONAL — sweep cron (Inngest syntax; default twice daily)
# DISCOVERY_SWEEP_ENABLED=false              # OPTIONAL — master gate for targeting + dispatch (default off)
# DISCOVERY_TWO_HOP_CONFIDENCE_FLOOR=0.6        # OPTIONAL — min path confidence (hop1*hop2) for a 2-hop transitive candidate
# DISCOVERY_VERTICAL=ai-ml-infra             # OPTIONAL — free-form InterestProfile label only; NOT the candidate scope (scope is DISCOVERY_RADAR_ID)
EXA_API_KEY=your-exa-api-key
# FACT_CHECK_GROUNDING_TIMEOUT_MS=20000        # OPTIONAL: per-claim grounding search wall-clock cap (500-120000)
# FACT_CHECK_MAX_CLAIMS=8                      # Max load-bearing claims verified per report (1-20)
# FACT_CHECK_MIN_REPORT_CHARS=800              # Reports shorter than this are skipped
# FACT_CHECK_MODEL=gemini-3-flash-preview      # Grounded-search model for claim verification
# FACT_CHECK_REASONING_MODEL=gemini-3.5-flash  # Claim extraction / judge model (no search)
# FACT_CHECK_TOTAL_TIMEOUT_MS=120000           # OPTIONAL: total grounding-phase wall-clock budget (1000-600000)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=<your-firebase-project-id>
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}    # inline JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=./path-to-service-account.json  # alias
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIRECRAWL_API_KEY=your-firecrawl-api-key
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GCLOUD_PROJECT=<your-firebase-project-id>
GEMINI_API_KEY=your-google-api-key  # Alias for GOOGLE_API_KEY
# GEMINI_CHAT_MAX_OUTPUT_TOKENS=50000                       # AI-assistant chat output cap (Gemini 3.x Pro max: 65536)
# GEMINI_CHAT_MODEL=gemini-3.1-pro-preview # AI Assistant chat model.
# GEMINI_COMPREHENSIVE_RESEARCH_MODEL=gemini-3.1-pro-preview # Comprehensive technology-research model.
# GEMINI_DEEP_RESEARCH_MODEL=deep-research-preview-04-2026  # Deep Research agent (Interactions API)
# GEMINI_EMBEDDING_DIM=768                                  # embedding dimensions (Matryoshka truncation)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001               # embeddings (Neo4j vectors)
# GEMINI_IMAGE_MODEL=gemini-3-pro-image                     # infographic + visualization image gen (Nano Banana Pro, GA)
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview                   # reasoning / complex-analysis tier
# GEMINI_TEXT_MODEL=gemini-3.5-flash                        # default text / structured-output model
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite # Diagram vision-critic model.
GITHUB_TOKEN=your-github-token
GOOGLE_API_KEY=your-google-api-key
# GOOGLE_APPLICATION_CREDENTIALS=./path-to-service-account.json
# GOOGLE_CLOUD_PROJECT=<your-firebase-project-id>
# GOOGLE_CLOUD_QUOTA_PROJECT=<your-firebase-project-id>
GOOGLE_GENAI_API_KEY=your-google-genai-api-key
# GRAPH_HEALTH_COUNT_DIFF=1
# GRAPH_HEALTH_PAIR_LOCKS=1 # Optional read-only Firestore RadarPlacement pair-lock drift audit.
# GRAPH_HEALTH_RELATION_LOCKS=1             # OPTIONAL read-only Firestore relation-triple lock audit
# GRAPH_HEALTH_SKIP_SCHEMA=1
GRAPH_SYNC_ENABLED=true                # Fire Neo4j sync events on entity mutations
# IMPULSE_AGENT_ALLOW_MODEL_FALLBACK=false # Explicitly authorize the reviewed fallback model only when needed.
# IMPULSE_AGENT_CREATOR_MODEL=claude-opus-4-8
# IMPULSE_AGENT_CURATOR_MODEL=claude-haiku-4-5
# IMPULSE_AGENT_DEFENSE_MINISTER_MODEL=claude-haiku-4-5
# IMPULSE_AGENT_EVALUATOR_MODEL=claude-sonnet-4-6
# IMPULSE_AGENT_FALLBACK_MODEL=claude-haiku-4-5
# IMPULSE_AGENT_LINKER_MODEL=claude-sonnet-4-6
# IMPULSE_AGENT_ORCHESTRATOR_MODEL=claude-sonnet-4-6 # OPTIONAL — direct orchestrator fallback when no role profile is supplied
# IMPULSE_AGENT_SCOUT_MODEL=claude-sonnet-4-6
# IMPULSE_AGENT_STRATEGIST_MODEL=claude-opus-4-8
IMPULSE_API_KEY=
# IMPULSE_BUILD_APPROVAL_TIMEOUT_HOURS=72      # final approval gate
# IMPULSE_BUILD_CLONE_ALLOWLIST=github.com,gitlab.com,registry.npmjs.org,pypi.org,files.pythonhosted.org  # Advisory in v1 (egress not yet enforced at the Docker layer)
# IMPULSE_BUILD_CONCURRENCY=1
# IMPULSE_BUILD_ENABLED=false                  # Master switch (missions API rejects kind:'build' when off)
# IMPULSE_BUILD_ENABLE_GITHUB_MCP=false        # github MCP (+ GITHUB_TOKEN)
# IMPULSE_BUILD_ENABLE_WEB_MCP=false           # exa/firecrawl inside the sandbox (+ their keys)
# IMPULSE_BUILD_ENV_ALLOWLIST=ANTHROPIC_API_KEY  # ONLY these cross into the container (+ auto conditionals)
# IMPULSE_BUILD_EVAL_PLATFORM_MCP=                    # Platform MCP for EVALUATION missions; empty (default) = no key in the box (they clone untrusted repos)
# IMPULSE_BUILD_EVAL_VOLUME_RETENTION_DAYS=1    # evaluations: reclaim fast — verdict already in the graph
# IMPULSE_BUILD_FAILED_VOLUME_RETENTION_DAYS=2  # failed/killed: kept 2 days for forensics, then reclaimed
# IMPULSE_BUILD_GATE_TIMEOUT_HOURS=24          # budget/stall human gates
# IMPULSE_BUILD_GC_THRESHOLD_HOURS=96          # build-specific stuck threshold (gated builds wait long)
# IMPULSE_BUILD_KEEP_ALIVE_MINUTES=240         # container kept post-publish for the preview iframe
# IMPULSE_BUILD_LIMITLESS_EFFORT=max
# IMPULSE_BUILD_LIMITLESS_ESCALATION_EFFORT=max
# IMPULSE_BUILD_LIMITLESS_MAX_MINUTES=120       # Per-role wall-clock cap; schema rejects values above 240
# IMPULSE_BUILD_LIMITLESS_MAX_SESSIONS=2
# IMPULSE_BUILD_LIMITLESS_MAX_TURNS=160
# IMPULSE_BUILD_LIMITLESS_MISSION_MAX_COST_USD=50
# IMPULSE_BUILD_LIMITLESS_MODEL_BUILD=claude-opus-4-8
# IMPULSE_BUILD_LIMITLESS_MODEL_ESCALATION=claude-opus-4-8
# IMPULSE_BUILD_LIMITLESS_MODEL_QA=claude-opus-4-8
# IMPULSE_BUILD_LIMITLESS_REVIEWER_MAX_COST_USD=10
# IMPULSE_BUILD_LIMITLESS_SESSION_MAX_COST_USD=40
# IMPULSE_BUILD_LIMITLESS_USE_GOAL=false        # Set true only for explicit /goal compatibility testing
# IMPULSE_BUILD_MAX_SESSIONS=8                 # Bounded-session loop cap per mission
# IMPULSE_BUILD_MCP_HOST_BASE_URL=http://host.docker.internal:9002/api/mcp
# IMPULSE_BUILD_MISSION_HARD_CAP_USD=150
# IMPULSE_BUILD_MISSION_MAX_COST_USD=25 # Maximum cost for one build-mission envelope.
# IMPULSE_BUILD_MODEL_BUILD=claude-sonnet-4-6  # phases 06–07
# IMPULSE_BUILD_MODEL_ESCALATION=claude-opus-4-8
# IMPULSE_BUILD_MODEL_PLAN=claude-sonnet-4-6   # phases 00–05
# IMPULSE_BUILD_MODEL_QA=claude-sonnet-4-6     # phase 08 (fresh-context reviewer)
# IMPULSE_BUILD_PLATFORM_MCP=                  # Default empty. For trusted solution missions only, opt in to the minimum set, e.g. entities,graph,reports; enabling passes the internal key
# IMPULSE_BUILD_POLL_INTERVAL_SECONDS=5
# IMPULSE_BUILD_POLL_WATCH_SECONDS=60
# IMPULSE_BUILD_PORT_RANGE_END=4199
# IMPULSE_BUILD_PORT_RANGE_START=4100          # Host ports for artifact previews
# IMPULSE_BUILD_QA_MAX_ATTEMPTS=1              # bounded fix+re-QA cycles
# IMPULSE_BUILD_SANDBOX_CPUS=2
# IMPULSE_BUILD_SANDBOX_DRIVER=docker          # docker (the only implemented backend; any other value is refused at config load)
# IMPULSE_BUILD_SANDBOX_IMAGE=radarist-build-sandbox
# IMPULSE_BUILD_SANDBOX_IMAGE_TAG=v2           # Bump on template change — versions the methodology pack
# IMPULSE_BUILD_SANDBOX_MEMORY_GB=4
# IMPULSE_BUILD_SANDBOX_NETWORK=bridge
# IMPULSE_BUILD_SANDBOX_PIDS_LIMIT=512         # Docker PID ceiling; accepted range 64-4096
# IMPULSE_BUILD_SESSION_MAX_COST_USD=6
# IMPULSE_BUILD_SESSION_MAX_MINUTES=30
# IMPULSE_BUILD_SESSION_MAX_OUTPUT_TOKENS=64000 # Validated per-session output-token ceiling.
# IMPULSE_BUILD_SESSION_MAX_TURNS=80
# IMPULSE_BUILD_STALL_ESCALATE_AFTER=2         # identical failing-check hashes → stronger model
# IMPULSE_BUILD_STALL_PAUSE_AFTER=3            # → human stall gate
# IMPULSE_BUILD_VOLUME_RETENTION_DAYS=7         # solution prototypes: reclaim after 7 days
# IMPULSE_BUILD_WARN_THRESHOLD=0.8
# IMPULSE_BUILD_WORKSPACE_PATH=/workspace
IMPULSE_CHAT_MAX_TOOL_CALLS=15
IMPULSE_CLAUDE_CHAT_MAX_BUDGET_USD=0.50  # Per-chat-turn cost cap (USD)
# IMPULSE_CLAUDE_CHAT_MAX_TOKENS=8000    # OPTIONAL — output-token cap per chat turn
# IMPULSE_GRAPH_STRICT=false
IMPULSE_INTERNAL_KEY=replace-with-any-random-string
# IMPULSE_LOG_FILE=                  # Agent log file path (default: logs/agent.log)
# IMPULSE_MCP_BASE_URL=http://localhost:9002/api/mcp
# IMPULSE_WORKSPACE= # Optional absolute Agent workspace override; defaults to the process workspace.
# INNGEST_BASE_URL= # Optional Inngest API base URL override; leave blank for the standard endpoint.
# INNGEST_DEV=http://127.0.0.1:8288
# INNGEST_DEV_SERVER_URL=http://127.0.0.1:8288   # script helper alias
# INNGEST_DEV_URL=http://127.0.0.1:8288          # app health/helper alias
# INNGEST_ENABLED=true
INNGEST_EVENT_KEY=your-inngest-event-key
# INNGEST_FUNCTION_PROFILE=full      # OPTIONAL — dev-only `interactive` selects the explicit cron-free operator registry
# INNGEST_OBSERVE=false
INNGEST_SIGNING_KEY=your-inngest-signing-key
LINKER_AUTOPILOT_ENABLED=false         # Auto-create relations with confidence >= threshold
LINKER_AUTO_APPROVE_THRESHOLD=75       # Confidence >= this → auto-create relation
# LOG_LEVEL=info
# MAINTENANCE_PAUSED=false
# MCP_DAILY_READ_BUDGET=1000
MCP_ERROR_WARN_THRESHOLD=3
MISSION_MAX_COST_USD=15.00
MISSION_MAX_TOOL_CALLS=100
# MISSION_PROMPT_MAX_CHARS=50000
MISSION_TIMEOUT_MINUTES=30
MISSION_TOKEN_BUDGET=50000
MISSION_WARN_THRESHOLD=0.8
# NEO4J_BENCHMARK_CONTAINER=radarist-neo4j-selftest
# NEO4J_BENCHMARK_DATA_VOLUME=radarist_neo4j_selftest_data
# NEO4J_DATABASE=neo4j
# NEO4J_INTERACTIVE_READ_BUDGET_MS=8000
NEO4J_PASSWORD=change-me-required
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_USERNAME=neo4j  # alias accepted by some script paths
NEWS_API_KEY=your-news-api-key
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:9002     # OPTIONAL — public local app origin; setup:local pins it to the selected profile
# NEXT_PUBLIC_CHAT_STREAMING=false       # client-side opt-in to request SSE streaming from the chat component (src/components/ai/AIChat.tsx)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-radarist.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-radarist
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-radarist.appspot.com
# NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_GRAPH_BACKEND=neo4j
# NEXT_PUBLIC_GRAPH_CACHE=true              # set to 'false' to disable
# NEXT_PUBLIC_GRAPH_CACHE_TTL=60000         # cache entry TTL (ms)
# NEXT_PUBLIC_INNGEST_ENABLED=false  # OPTIONAL — browser-visible kill switch; next.config derives false from INNGEST_ENABLED=false
# NEXT_PUBLIC_QUERY_DEVTOOLS=0
# NEXT_PUBLIC_USE_AUTH_EMULATOR=false
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
# NEXT_PUBLIC_USE_FIRESTORE_STORAGE=false
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api   # approved origin: https + host openrouter.ai only
# PER_DIAGRAM_VISION_EVAL=false
# PRELUDE_CONCURRENCY=6                        # Max parallel skill loads
# PRELUDE_MAX_TARGETS=6                        # Max normalized, deduplicated targets eligible for prelude helper sessions
# PRELUDE_MAX_TOTAL_COST_USD=2.00               # Total prelude budget (USD)
# PRELUDE_PER_SKILL_COST_USD=0.30              # Per-skill cost cap (USD)
# PRELUDE_PER_SKILL_TIMEOUT_MS=60000           # Per-skill fetch timeout (ms)
# QUALITY_LLM_SAMPLE_RATE=1.0
# RADARIST_API_URL=http://127.0.0.1:9002/api/mcp
# RADARIST_CHECKPOINT_MAX_RETAINED_BYTES=21474836480 # OPTIONAL LOCAL — per-profile checkpoint cap (20 GiB default)
# RADARIST_CHECKPOINT_RESERVE_BYTES=536870912 # OPTIONAL LOCAL — minimum free disk reserve; malformed values fail startup/checkpoint
RADARIST_GRAPH_RUNTIME_MODE=neo4j
# REPORT_COMPOSER_MODE=                                     # OPTIONAL — structured report composer. Default/unset = proven legacy HTML authoring; set exactly `template` to let mission agents draft typed ReportBlocksDoc blocks for server-side composition. Requires a server/agent restart after changing.
# RESEARCH_CONTACT_EMAIL=you@example.com
# REVISION_MAX_COST_USD=12.00
SERPAPI_KEY=your-serpapi-key
SIGNAL_AUTOPILOT_ENABLED=false         # Inngest expansion only: auto-import eligible Technology after score + 2-source gate
SIGNAL_AUTO_APPROVE_THRESHOLD=85       # Integer 0-100; also requires 2 distinct confirming URLs + Technology profile
# SIGNAL_ENRICH_BATCH_CRON='TZ=UTC 0 */6 * * *'   # batch-mode sweep schedule
# SIGNAL_ENRICH_BATCH_LIMIT=20         # max signals enriched per batch sweep
SIGNAL_ENRICH_ON_LIKE=online           # online (default) = enrich immediately on like · batch = a cron sweeps liked-but-unexpanded · off
# SWEEP_CRON=TZ=UTC 0 0,6,12,18 * * *          # Cron expression for sweep cadence
# SWEEP_MAX_MISSIONS_PER_CYCLE=5               # Cap missions kicked off per cycle
# SWEEP_REVERIFICATION_AGE_DAYS=14             # Re-verify edges/entities older than N days
TAVILY_API_KEY=your-tavily-api-key
