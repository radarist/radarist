{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://radarist.local/schemas/provider-rate-card.json",
  "title": "Canonical provider rate card (TEST-021)",
  "description": "Authored source of truth for provider token pricing. Runtime validation in src/lib/ai/rate-card.ts (assertValidRateCard) enforces the invariants this schema documents plus tier ordering that JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "effectiveDate", "currency", "unit", "providers"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "effectiveDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "currency": { "type": "string", "enum": ["USD"] },
    "unit": { "type": "string", "enum": ["per 1M tokens"] },
    "note": { "type": "string" },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["google", "anthropic"],
      "properties": {
        "google": { "$ref": "#/definitions/provider" },
        "anthropic": { "$ref": "#/definitions/provider" }
      }
    }
  },
  "definitions": {
    "provider": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "displayName",
        "source",
        "sourceDate",
        "cachedInputIsSubsetOfInput",
        "outputIncludesThinking",
        "models"
      ],
      "properties": {
        "displayName": { "type": "string" },
        "source": { "type": "string", "pattern": "^https://" },
        "sourceDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "cachedInputIsSubsetOfInput": { "type": "boolean" },
        "outputIncludesThinking": { "type": "boolean" },
        "note": { "type": "string" },
        "fees": { "type": "object" },
        "models": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/model" }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tiers"],
      "properties": {
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/tier" }
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxContextTokens"],
      "properties": {
        "maxContextTokens": { "type": ["integer", "null"], "minimum": 1 },
        "input": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 },
        "cacheRead": { "type": "number", "minimum": 0 },
        "cacheWrite5m": { "type": "number", "minimum": 0 },
        "cacheWrite1h": { "type": "number", "minimum": 0 },
        "cacheStoragePerHour": { "type": "number", "minimum": 0 },
        "validUntil": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
