# Minimal local Radarist runtime. Copy to .env.local; these values are safe local defaults.

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-radarist.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-radarist
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-radarist.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GOOGLE_CLOUD_PROJECT=demo-radarist
GCLOUD_PROJECT=demo-radarist
RADARIST_GRAPH_RUNTIME_MODE=neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-required
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
INNGEST_ENABLED=true
INNGEST_EVENT_KEY=local-dev
INNGEST_SIGNING_KEY=local-dev
IMPULSE_INTERNAL_KEY=change-me-for-local-development
