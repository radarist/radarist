# ── Required ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Platform Connection ───────────────────────────────────────
# Optional — defaults to http://localhost:9002/api/mcp when unset (src/config.ts)
IMPULSE_MCP_BASE_URL=http://localhost:9002/api/mcp
# Must be the SAME value as the app's IMPULSE_INTERNAL_KEY (root .env.local) —
# the agent authenticates to the app's /api/mcp/* servers with this shared secret.
IMPULSE_API_KEY=your-impulse-api-key

# ── Neo4j (used by the neo4j-memory MCP) ───────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── Research APIs ─────────────────────────────────────────────
EXA_API_KEY=your-exa-api-key
FIRECRAWL_API_KEY=your-firecrawl-api-key
GOOGLE_API_KEY=your-google-api-key

# ── Logging ──────────────────────────────────────────────────
# IMPULSE_LOG_FILE=logs/agent.log   (default: <project>/logs/agent.log)
# IMPULSE_LOG_FILE=none             (disable file logging)
