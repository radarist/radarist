{
  "name": "@impulse/agent",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "impulse-agent": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./orchestrator": "./dist/orchestrator-lite.js",
    "./sandbox": "./dist/sandbox/index.js"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/sandbox/template dist/runtime-plugin && cp -R src/sandbox/template dist/sandbox/template && cp -R runtime-plugin dist/runtime-plugin",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --no-coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.109",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "fast-uri@3.x": "^3.1.5",
    "ip-address@10.x": "^10.3.1",
    "hono@4.x": "~4.12.34",
    "brace-expansion@1.x": "^1.1.18",
    "brace-expansion@2.x": "^2.1.4",
    "@hono/node-server": "^2.0.5",
    "body-parser@2.x": "^2.3.0"
  }
}
